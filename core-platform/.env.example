# The core platform's local environment variables (copy to .env — gitignored).
# NO secret in the clear in the repository: a committed secret is considered
# compromised (an immediate rotation). The LLM provider key lives in the
# secret store, under secret/core/<provider>.

# The `llm.internal` LLM gateway — a SWITCHABLE provider.
# The active provider is persisted in the store (secret/core/llm-provider); these
# variables only serve to SEED the key on the first run (or after a purge).
#
#   LLM_PROVIDER=openai      (the default)  -> secret/core/openai
#   LLM_PROVIDER=anthropic             -> secret/core/anthropic
#
#LLM_PROVIDER=openai
#OPENAI_API_KEY=sk-...
# The Anthropic API key (console.anthropic.com) — NOT a Claude Code OAuth token
# (sk-ant-oat01-…), which is tied to the subscription and does not authenticate the API.
#ANTHROPIC_API_KEY=sk-ant-api03-...

# The object store's admin credentials (SeaweedFS). Defaults are public on
# purpose — a workshop needs them readable on a slide. Override for anything
# that outlives a workshop.
#S3_ROOT_USER=platformadmin
#S3_ROOT_PASSWORD=platformadmin-dev-password

# The secret store's coordinates, if your stack is not the default one.
# Both prefixes are honoured (BAO_* wins, VAULT_* accepted for compatibility).
#BAO_ADDR=http://localhost:8200
#BAO_TOKEN=root-dev-token
